<div class="page">
  <div class="page-header">
    <a href="<%= basePath %>/vod" style="color:var(--muted)"><i class="fas fa-arrow-left"></i></a>
    <i class="fas fa-play-circle" style="color:var(--accent)"></i>
    <h2><%= vod.title %></h2>
    <span class="badge"><%= vod.status %></span>
  </div>

  <div class="admin-section" style="overflow:hidden;padding:0">
    <div style="position:relative;min-height:220px;background:#0a0d12">
      <% if (vod.backdrop) { %>
      <img src="<%= vod.backdrop %>" alt="<%= vod.title %>" style="width:100%;height:260px;object-fit:cover;opacity:.5" onerror="this.remove()">
      <% } %>
      <div style="position:absolute;inset:0;display:flex;align-items:flex-end;padding:14px;background:linear-gradient(180deg,rgba(0,0,0,0),rgba(0,0,0,.75))">
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
          <% if (vod.poster) { %><img src="<%= vod.poster %>" alt="poster" style="width:94px;height:130px;object-fit:cover;border-radius:10px;border:1px solid var(--border)"><% } %>
          <% if (vod.logo_url) { %><img src="<%= vod.logo_url %>" alt="logo" style="width:58px;height:58px;object-fit:contain;border-radius:10px;border:1px solid var(--border);background:rgba(0,0,0,.45);padding:6px"><% } %>
          <div>
            <div style="font-size:1.3rem;font-weight:700"><%= vod.title %></div>
            <div style="color:var(--muted);font-size:.8rem;margin-top:4px"><%= vod.year %> • <%= vod.genre %> • <%= vod.language %> • <%= vod.duration %> min</div>
            <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap">
              <button class="a-btn a-btn-primary" onclick="openVodPlayer()"><i class="fas fa-play"></i> Play</button>
              <% if (vod.trailer_url) { %>
              <a class="a-btn a-btn-purple" target="_blank" rel="noopener" href="<%= vod.trailer_url %>"><i class="fas fa-video"></i> Trailer</a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="admin-section">
    <h3><i class="fas fa-fire" style="color:var(--orange)"></i> Të ngjashme</h3>
    <div class="channels-grid" style="grid-template-columns:repeat(auto-fill,minmax(160px,1fr));"><%- relatedCardsHtml %></div>
  </div>

  <div id="vodPlayerModal" class="modal-overlay" style="display:none;z-index:1200">
    <div class="modal" style="max-width:980px;width:96%">
      <div class="modal-header">
        <div class="modal-title"><i class="fas fa-play"></i> <%= vod.title %></div>
        <button class="modal-close" onclick="closeVodPlayer()"><i class="fas fa-times"></i></button>
      </div>
      <div class="player-stage" style="min-height:460px">
        <% if (vod.watermark_enabled) { %>
        <div id="vodWatermark" class="dynamic-watermark pos-<%= vod.watermark_position || 'bottom-right' %>" style="display:block;opacity:<%= vod.watermark_opacity || 0.3 %>"><%= vod.watermark_text || '' %></div>
        <% } %>
        <video id="vodVideo" controls playsinline style="width:100%;height:460px;background:#000" src="<%= vod.playback_url || vod.source_url %>"></video>
      </div>
    </div>
  </div>
</div>

<script>
const BASE='<%= basePath %>';
const VOD_ID='<%= vod.id %>';
const vodWmEnabled=<%= vod.watermark_enabled ? 'true' : 'false' %>;
const vodWmUpdateSec=<%= Number(vod.watermark_update_sec || 8) %>;
let vodViewTracked=false;
let progressTimer=null;
function postVodAnalytics(path,payload){
  return fetch(BASE+path,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload||{})}).catch(()=>{});
}
function openVodPlayer(){
  document.getElementById('vodPlayerModal').style.display='flex';
  const v=document.getElementById('vodVideo');
  if(v){ v.play().catch(()=>{}); }
  if(!vodViewTracked){ vodViewTracked=true; postVodAnalytics('/api/vod/analytics/view',{id:VOD_ID}); }
  if(progressTimer) clearInterval(progressTimer);
  progressTimer=setInterval(()=>{
    const video=document.getElementById('vodVideo');
    if(!video||video.paused) return;
    const duration=Number(video.duration||0);
    const current=Number(video.currentTime||0);
    const completed=duration>0 && current/duration>=0.9;
    postVodAnalytics('/api/vod/analytics/progress',{id:VOD_ID,watch_time_sec:Math.round(current),completed});
  },15000);
}
function closeVodPlayer(){
  const modal=document.getElementById('vodPlayerModal');
  const v=document.getElementById('vodVideo');
  if(modal) modal.style.display='none';
  if(v){ v.pause(); }
}
const vodVideo=document.getElementById('vodVideo');
if(vodVideo){
  vodVideo.addEventListener('ended',()=>postVodAnalytics('/api/vod/analytics/progress',{id:VOD_ID,watch_time_sec:Math.round(vodVideo.duration||0),completed:true}));
}
if(vodWmEnabled){
  const wm=document.getElementById('vodWatermark');
  if(wm){
    setInterval(()=>{ wm.style.opacity=(0.2+Math.random()*0.45).toFixed(2); }, Math.max(3, vodWmUpdateSec)*1000);
  }
}
</script>
