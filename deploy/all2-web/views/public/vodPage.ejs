<div class="page vod-page">
  <style>
    .vod-page .vod-hero{position:relative;overflow:hidden;border:1px solid var(--border);border-radius:18px;padding:20px;background:linear-gradient(130deg,rgba(0,212,255,.16),rgba(0,140,255,.12) 35%,rgba(139,92,246,.2));box-shadow:0 20px 45px rgba(0,0,0,.25);margin-bottom:16px}
    .vod-page .vod-hero:before{content:'';position:absolute;inset:-20% auto auto -10%;width:220px;height:220px;background:radial-gradient(circle,rgba(255,255,255,.15),transparent 70%);pointer-events:none}
    .vod-page .vod-title{display:flex;align-items:center;gap:10px;font-size:clamp(1.2rem,2.8vw,1.65rem);font-weight:800;letter-spacing:.2px}
    .vod-page .vod-sub{margin-top:8px;color:rgba(232,234,240,.84);max-width:760px;font-size:.9rem}
    .vod-page .vod-kpis{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
    .vod-page .kpi{background:rgba(0,0,0,.25);border:1px solid rgba(255,255,255,.15);padding:8px 12px;border-radius:999px;font-size:.74rem}
    .vod-page .filters-shell{background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.01));border:1px solid var(--border);border-radius:14px;padding:14px;backdrop-filter:blur(6px)}
    .vod-page .filters-shell form{display:grid!important;grid-template-columns:1fr!important;gap:10px!important}
    .vod-page .cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:16px}
    .vod-page .vod-card{display:block;border:1px solid var(--border);border-radius:14px;overflow:hidden;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.01));box-shadow:0 12px 24px rgba(0,0,0,.2);transition:transform .22s ease,border-color .22s ease,box-shadow .22s ease}
    @media (hover:hover){.vod-page .vod-card:hover{transform:translateY(-4px);border-color:var(--accent);box-shadow:0 18px 30px rgba(0,0,0,.28)}}
    .vod-page .thumb{position:relative;aspect-ratio:2/3;background:linear-gradient(120deg,#121722,#0d1118);display:flex;align-items:center;justify-content:center}
    .vod-page .thumb img{width:100%;height:100%;object-fit:cover}
    .vod-page .thumb i{font-size:1.5rem;color:var(--muted)}
    .vod-page .meta{padding:11px}
    .vod-page .name{font-size:.88rem;font-weight:700;line-height:1.3;min-height:38px}
    .vod-page .tags{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:7px}
    .vod-page .tag{font-size:.62rem;border:1px solid var(--border);color:var(--muted);padding:3px 7px;border-radius:999px;background:rgba(255,255,255,.02)}
    .vod-page .year-badge{position:absolute;right:8px;top:8px;padding:4px 8px;border-radius:999px;background:rgba(0,0,0,.55);border:1px solid rgba(255,255,255,.2);font-size:.62rem}
    .vod-page .pagination{margin-top:18px;display:flex;justify-content:center}
    .vod-page .pagination .a-btn{border-radius:999px;padding:8px 14px}
    @media (min-width:700px){.vod-page .filters-shell form{grid-template-columns:2fr 1fr 1fr 1fr auto!important}.vod-page .cards{grid-template-columns:repeat(3,minmax(0,1fr))}}
    @media (min-width:1100px){.vod-page .cards{grid-template-columns:repeat(5,minmax(0,1fr))}}
  </style>

  <section class="vod-hero">
    <div style="display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap">
      <div class="vod-title"><i class="fas fa-clapperboard" style="color:#fff"></i> <span data-i18n="vod_title">Shif Shqip VOD</span></div>
      <div style="display:flex;gap:6px">
        <button class="a-btn a-btn-primary" style="padding:4px 10px;font-size:.68rem" onclick="setVodLang('sq')">SQ</button>
        <button class="a-btn a-btn-purple" style="padding:4px 10px;font-size:.68rem" onclick="setVodLang('en')">EN</button>
      </div>
    </div>
    <div class="vod-sub" data-i18n="vod_desc">Filma dhe seriale të organizuara sipas kategorive.</div>
    <div class="vod-kpis">
      <span class="kpi"><i class="fas fa-shield-alt"></i> Player stabil</span>
      <span class="kpi"><i class="fas fa-filter"></i> Filtra dinamikë</span>
      <span class="kpi"><i class="fas fa-gauge-high"></i> UI moderne</span>
    </div>
  </section>

  <section class="filters-shell">
    <%- filtersHtml %>
  </section>

  <section class="cards"><%- cardsHtml %></section>

  <section class="pagination"><%- paginationHtml %></section>
</div>
<script>
const VOD_I18N={
  sq:{vod_title:'Shif Shqip VOD',vod_desc:'Filma dhe seriale të organizuara sipas kategorive.'},
  en:{vod_title:'Shif Shqip VOD',vod_desc:'Movies and series organized by categories.'}
};
function setVodLang(lang){
  const l=VOD_I18N[lang]||VOD_I18N.sq;
  Object.entries(l).forEach(([k,v])=>{const node=document.querySelector('[data-i18n=\"'+k+'\"]'); if(node) node.textContent=v;});
  try{localStorage.setItem('k1_vod_lang',lang);}catch{}
}
try{setVodLang(localStorage.getItem('k1_vod_lang')||'sq');}catch{setVodLang('sq');}
</script>
