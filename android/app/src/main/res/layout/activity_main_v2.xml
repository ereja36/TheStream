<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/design_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/v2_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/scroll_bottom_chrome_inset_with_ads">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/hero_container"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:minHeight="@dimen/hero_min_height"
                    app:layout_constraintDimensionRatio="H,16:9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/hero_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/spacing_xxlarge"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/ic_launcher" />

                    <FrameLayout
                        android:id="@+id/hero_preview_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_v2_hero_gradient"
                        android:clickable="false"
                        android:focusable="false" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_xlarge">

                        <TextView
                            android:id="@+id/live_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_v2_live_badge"
                            android:paddingStart="@dimen/spacing_middle"
                            android:paddingTop="4dp"
                            android:paddingEnd="@dimen/spacing_middle"
                            android:paddingBottom="4dp"
                            android:text="● LIVE"
                            android:textColor="@color/color_white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hero_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="Shif Shqip"
                            android:textColor="@color/v2_text_primary"
                            android:textSize="@dimen/text_hero_title_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hero_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="TV"
                            android:textColor="@color/v2_text_secondary"
                            android:textSize="@dimen/text_content_sub_title_size" />

                        <TextView
                            android:id="@+id/hero_epg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/v2_accent"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_middle"
                            android:gravity="end|center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/btn_hero_mute"
                                android:layout_width="@dimen/top_action_icon_size"
                                android:layout_height="@dimen/top_action_icon_size"
                                android:layout_marginEnd="@dimen/spacing_middle"
                                android:background="@drawable/bg_v2_glass_nav_pill"
                                android:contentDescription="@string/player_mute"
                                android:padding="@dimen/spacing_small"
                                android:src="@android:drawable/ic_lock_silent_mode"
                                android:tint="@color/color_white"
                                android:visibility="gone" />

                            <Button
                                android:id="@+id/btn_watch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/top_action_icon_size"
                                android:background="@drawable/bg_v2_watch_button"
                                android:minWidth="100dp"
                                android:text="Watch"
                                android:textAllCaps="false"
                                android:textColor="@color/color_white"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/banner_all_channels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/screen_padding_horizontal"
                android:background="@drawable/bg_v2_glass_panel"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xlarge">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALL CHANNELS"
                    android:textColor="@color/v2_text_primary"
                    android:textSize="@dimen/text_content_title_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Browse all available channels"
                    android:textColor="@color/v2_text_secondary"
                    android:textSize="@dimen/text_sub_title_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/category_sections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/screen_padding_horizontal" />

            <TextView
                android:id="@+id/empty_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/spacing_xlarge"
                android:text="@string/no_post_found"
                android:textColor="@color/v2_text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

        <ImageView
            android:id="@+id/img_app_logo"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_gravity="top|start"
            android:contentDescription="@null"
            android:visibility="gone" />

    <LinearLayout
        android:id="@+id/top_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="@dimen/spacing_large"
        android:background="@drawable/bg_v2_glass_nav_pill"
        android:elevation="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_small"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/spacing_small"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btn_add_playlist"
            android:layout_width="@dimen/nav_icon_size"
            android:layout_height="@dimen/nav_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/playlist_add"
            android:padding="@dimen/spacing_small"
            android:src="@android:drawable/ic_input_add"
            android:tint="@color/color_white" />

        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="@dimen/nav_icon_size"
            android:layout_height="@dimen/nav_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search"
            android:padding="@dimen/spacing_small"
            android:src="@android:drawable/ic_menu_search"
            android:tint="@color/color_white" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="@dimen/nav_icon_size"
            android:layout_height="@dimen/nav_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/title_nav_settings"
            android:padding="@dimen/spacing_small"
            android:src="@drawable/settings"
            android:tint="@color/color_white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:elevation="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/bottom_nav_pill"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/nav_fab_size"
            android:layout_marginBottom="@dimen/spacing_small"
            android:background="@drawable/bg_v2_glass_nav_pill"
            android:elevation="28dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_large"
            android:paddingEnd="@dimen/spacing_large">

            <ImageButton
                android:id="@+id/nav_home"
                android:layout_width="@dimen/logo_size_medium"
                android:layout_height="@dimen/logo_size_medium"
                android:layout_marginEnd="@dimen/spacing_large"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_nav_recent"
                android:src="@drawable/ic_nav_home"
                android:tint="@color/v2_accent" />

            <ImageButton
                android:id="@+id/nav_categories"
                android:layout_width="@dimen/logo_size_medium"
                android:layout_height="@dimen/logo_size_medium"
                android:layout_marginEnd="@dimen/spacing_large"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_nav_category"
                android:src="@drawable/ic_nav_category"
                android:tint="@color/color_white" />

            <ImageButton
                android:id="@+id/nav_favorites"
                android:layout_width="@dimen/logo_size_medium"
                android:layout_height="@dimen/logo_size_medium"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_nav_favorite"
                android:src="@drawable/ic_nav_favorite"
                android:tint="@color/color_white" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/banner_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/admob_banner_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.solodroidx.ads.ui.BannerAdView
                android:id="@+id/bannerAdView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
