<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_player_dialog_card"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/quick_gestures_hold_title"
        android:textColor="@color/color_dark_accent"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/quick_gestures_brightness"
        android:textColor="#4B5563"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/seek_brightness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressTint="@color/color_dark_accent"
        android:thumbTint="@color/color_dark_accent" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/quick_gestures_volume"
        android:textColor="#4B5563"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/seek_volume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:progressTint="@color/color_dark_accent"
        android:thumbTint="@color/color_dark_accent" />
</LinearLayout>
