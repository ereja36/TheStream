<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/settings_space">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/playlist_setup_subtitle"
                android:textSize="@dimen/text_content_sub_title_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_default"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/playlist_device_id_label"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_device_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_copy_device_id"
                    style="@style/MaterialButtonStyleBorder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/playlist_copy_device_id" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_playlist"
                style="@style/MaterialButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/playlist_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_file"
                style="@style/MaterialButtonStyleBorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/playlist_open_file" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_xtream"
                style="@style/MaterialButtonStyleBorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/playlist_add_xtream" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_website"
                style="@style/MaterialButtonStyleBorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/playlist_add_website" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_play_url"
                style="@style/MaterialButtonStyleBorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/playlist_play_url" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/playlist_setup_note"
                android:textSize="@dimen/text_sub_title_size" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
