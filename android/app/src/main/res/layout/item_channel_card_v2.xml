<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/channel_card_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/spacing_middle"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/channel_media"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:minHeight="@dimen/channel_card_media_min_height"
            app:layout_constraintDimensionRatio="H,3:2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_v2_channel_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_small">

                <ImageView
                    android:id="@+id/channel_logo"
                    android:layout_width="@dimen/channel_card_logo_size"
                    android:layout_height="@dimen/channel_card_logo_size"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/channel_name_inline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="@color/v2_card_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_favorite"
                android:layout_width="@dimen/channel_card_fav_size"
                android:layout_height="@dimen/channel_card_fav_size"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/spacing_small"
                android:background="@drawable/bg_circle_transparent"
                android:contentDescription="@string/msg_favorite_add"
                android:src="@android:drawable/btn_star_big_off"
                android:tint="@color/v2_card_text" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/channel_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/v2_text_primary"
        android:textSize="12sp" />
</LinearLayout>
