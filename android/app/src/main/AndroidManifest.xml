<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".activities.MyApplication"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <activity
            android:name=".activities.ActivitySplash"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.MainActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="OPEN_MAIN_ACTIVITY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.ActivityMainV2"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivityMainV3"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivityChannelDetail"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivityNotificationDetail"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivityCategoryDetail"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivitySearch"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivityPlayerVideo"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivityPlayerYoutube"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivityPlayerWebView"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivityPrivacyPolicy"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivityWebView"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivityRedirect"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivitySettings"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivityPlaylistCategories"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <activity
            android:name=".activities.ActivityPlaylistSetup"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <service
            android:name=".notification.MyFirebaseMessageService"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_onesignal_default" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/color_light_primary" />

        <meta-data
            android:name="com.onesignal.NotificationOpened.DEFAULT"
            android:value="DISABLE" />

    </application>

</manifest>